        },
        {
          "id": "dots",
          "type": "dots",
          "total": 5,
          "atual": 4,
          "size": 10,
          "gap": 10,
          "cor_ativa": "$color.dots.ativa",
          "cor_inativa": "$color.dots.inativa",
          "pos": {
            "anchor": "bottom_right",
            "x": 96,
            "y": 100
          }
        },
        {
          "id": "grain",
          "type": "texture",
          "opacity": "$efeitos.grao.opacity",
          "blend": "$efeitos.grao.blend",
          "escala": "$efeitos.grao.escala",
          "piso": "$efeitos.grao.piso",
          "amplitude": "$efeitos.grao.amplitude"
        }
      ]
    }
  ]
}