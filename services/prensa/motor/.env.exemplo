# PRENSA — credenciais. Copie para `.env` nesta pasta e preencha.
# Lido por `ambiente.py`, a porta ÚNICA. Nenhum outro arquivo do PRENSA
# pode abrir .env, ler os.environ de chave ou montar Authorization.
#
# `.env` NUNCA é versionado, nunca é copiado para o Volc OS, e nunca sai
# desta máquina. Deixe em modo 600 (`chmod 600 .env`) — ambiente.py avisa
# em stderr se estiver legível por grupo/outros.
#
# Precedência (a primeira que responder ganha):
#   1. variável exportada no shell        — vence sempre
#   2. $VOLC_ENV_FILE                     — caminho explícito
#   3. <prensa-poc>/.env                  — este arquivo
#   4. <RAIZ_VOLC>/.env                   — raiz do workspace
#   5. <RAIZ_VOLC>/motor-video/.env       — PONTE LEGADA, avisa e vai sair

# gpt-image-2 — fundo fotográfico sem tipografia (Lei 1: o modelo de imagem
# nunca escreve letra). Usado por gen_bg.py, gen_kintsugi.py, gen_planejado.py.
# LOW ~US$0,013 · MEDIUM ~US$0,05
OPENAI_API_KEY=

# Gemini — juiz VLM (audita_video.py) e provider de fallback de imagem.
GEMINI_API_KEY=

# Pexels — provider_chain de foto do spec. Opcional: sem ela, a cadeia pula
# o Pexels em vez de falhar.
PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# Opcionais — só para mover raízes (útil ao empacotar o POC sozinho no Volc OS).
#
# VOLC_RAIZ       raiz do workspace que contém motor-imagem e motor-video.
#                 Default: traversal relativo a partir desta pasta.
# VOLC_ENV_FILE   caminho explícito para um .env. Se apontar para arquivo
#                 inexistente é ERRO — silêncio ali seria mentira.
