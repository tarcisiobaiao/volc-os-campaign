<saida>
Somente JSON, sem markdown:
{"versao": "revisao-v1",
 "decisao": "aprovado|ajustar|revisao_humana",
 "achados": [{"id": "a1", "severidade": "bloqueante|ajuste|nota", "categoria": "erro_factual|risco_politica|congruencia_destino|identidade|estilo|oportunidade", "campo": "<campo>", "trecho": "<texto exato>", "motivo": "<por quê>", "evidencia": {"tipo": "<tipo>", "ref": "<id>"}}],
 "patches": [{"achado": "a1", "campo": "<campo>", "antes": "<trecho exato e único>", "depois": "<substituição mínima>"}],
 "afirmacoes_nao_verificadas": [{"campo": "<campo>", "trecho": "<texto>", "por_que": "<sem fato no inventário>"}],
 "preservado": ["<o que você manteve de propósito: ângulo, benefício, voz, rótulos>"],
 "notas": {{ exemplo_de_notas }}
}
</saida>
