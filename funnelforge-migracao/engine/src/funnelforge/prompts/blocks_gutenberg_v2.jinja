<!-- /wp:list -->

════════ BARRA DE PROGRESSO (wp:html — [PERCENTUAL] REAL da base; senão não use) ════════
<!-- wp:html -->
<div role="img" aria-label="[PERCENTUAL]% — [o que esse percentual representa]" style="background:#e5e7eb;border-radius:999px;height:14px;overflow:hidden;margin:16px 0 4px">
<div style="width:[PERCENTUAL]%;background:#16a34a;height:100%"></div>
</div>
<div style="margin:0 0 24px;font-size:0.9em;color:#475569">[o que esse percentual representa]</div>
<!-- /wp:html -->

════════ TABELA COMPARATIVA (wp:table striped — só para atributos comparáveis; sempre com cabeçalho) ════════
<!-- wp:table {"className":"is-style-stripes"} -->
<figure class="wp-block-table is-style-stripes"><table><thead><tr><th>[Coluna 1]</th><th>[Coluna 2]</th></tr></thead><tbody><tr><td>[dado]</td><td>[dado]</td></tr><tr><td>[dado]</td><td>[dado]</td></tr></tbody></table></figure>
<!-- /wp:table -->

════════ DUAS COLUNAS (wp:columns — "se A / se B", lado a lado) ════════
<!-- wp:columns {"style":{"spacing":{"margin":{"top":"24px","bottom":"24px"}}}} -->
<div class="wp-block-columns"><!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph --><p>[coluna A]</p><!-- /wp:paragraph --></div>
<!-- /wp:column --><!-- wp:column -->
<div class="wp-block-column"><!-- wp:paragraph --><p>[coluna B]</p><!-- /wp:paragraph --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->

════════ PULLQUOTE (a frase que resume a resposta — MOVA uma frase que já está no texto; não a duplique num parágrafo) ════════
<!-- wp:pullquote {"style":{"spacing":{"margin":{"top":"28px","bottom":"28px"}}}} -->
<figure class="wp-block-pullquote" style="margin:28px 0"><blockquote><p>[a frase que resume a resposta desta seção]</p></blockquote></figure>
<!-- /wp:pullquote -->

════════ SEPARADOR (wp:separator) ════════
<!-- wp:separator {"className":"is-style-wide"} -->
<hr class="wp-block-separator has-alpha-channel-opacity is-style-wide"/>
<!-- /wp:separator -->

════════ PERGUNTAS DO LEITOR (wp:details — accordion nativo, sem shortcode) ════════
<!-- wp:details -->
<details class="wp-block-details"><summary>[Pergunta real do leitor?]</summary><!-- wp:paragraph -->
<p>[Resposta completa e direta.]</p>
<!-- /wp:paragraph --></details>
<!-- /wp:details -->
(Um bloco wp:details por pergunta real, com a pergunta no <summary>; quantas a dúvida pedir.)
