# SERVER-SIDE ONLY - NEVER COMMIT TO GIT
# Copy this file to .env.server and fill in your actual values

# Supabase oficial do VOLC O.S. (server-side)
# Este projeto não usa um Supabase hospedado como alternativa operacional.
SUPABASE_URL=https://database.agenciavolc.com.br
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server Configuration
SERVER_PORT=3001

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# N8N Webhook Configuration (if needed)
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret-here

# =====================================================================
# Meta CAPI — chave mestra de cifra do access token (v7_13)
# =====================================================================
# Gerar (32 bytes aleatórios em base64):
#
#     openssl rand -base64 32
#
# Para que serve: o access token da Conversions API de cada site é gravado
# CIFRADO (AES-GCM 256) na tabela `meta_capi_sites`. Esta é a chave que
# cifra e decifra. Ela nunca vai para o banco — só existe em env var.
#
# A MESMA chave precisa estar em TRÊS lugares, senão a cadeia quebra:
#   1. aqui (.env.server), para o dev server cifrar ao salvar no wizard;
#   2. nas Environment Variables do projeto na Vercel (produção);
#   3. nos secrets da Edge Function `capi-router`, que é quem decifra na
#      hora de enviar o evento para a Meta:
#         supabase secrets set CAPI_MASTER_KEY='<a mesma chave>'
#
# Se a chave estiver ausente, o endpoint /api/meta-capi/sites responde 503 e
# NÃO grava nada — nunca há fallback para token em texto puro.
# Se a chave for ROTACIONADA, os tokens já gravados param de decifrar e
# precisam ser recadastrados site a site.
CAPI_MASTER_KEY=
