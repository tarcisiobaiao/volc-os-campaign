# Supabase (obrigatório para o frontend)
# IMPORTANTE: Use SEMPRE o endpoint da agência VOLC
VITE_SUPABASE_URL=https://database.agenciavolc.com.br
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Opcional: apenas para uso server-side (ex.: API routes, Vercel serverless)
SUPABASE_SERVICE_ROLE_KEY=

# Secret key base (opcional)
SECRET_KEY_BASE=

# Secure API Backend URL
VITE_API_URL=http://localhost:3001

# Production URL (configure this in Vercel)
VITE_SITE_URL=https://your-domain.vercel.app

# v6 RBAC Admin (Etapa 3.A — opcional, default desligado)
# Liga a área /admin/v6 (read-only) com o sistema novo de roles,
# memberships e comissões versionadas. Mesmo ligada, só usuários
# com role ADMIN têm acesso. Em produção, mantenha desligada até o
# cutover ser planejado. Reinicie o dev server após mudar essa flag.
VITE_USE_V6_ADMIN=false

# =====================================================================
# ATENÇÃO — daqui para baixo NÃO é configuração de frontend
# =====================================================================
# As variáveis abaixo são lidas pelas funções serverless em `api/` (servidor).
# Estão documentadas aqui porque, no deploy da Vercel, todas as variáveis do
# projeto — de frontend e de servidor — são cadastradas no mesmo painel.
#
# REGRA ABSOLUTA: NUNCA prefixe nenhuma delas com `VITE_`. O Vite injeta no
# bundle TUDO que começa com VITE_, ou seja, um `VITE_CAPI_MASTER_KEY` iria
# em texto puro para o JavaScript público e daria a qualquer visitante a chave
# que decifra os tokens da Meta de todos os sites.

# Meta CAPI — chave mestra de cifra do access token (v7_13)
# Gerar com:
#
#     openssl rand -base64 32
#
# (32 bytes aleatórios em base64). Cifra/decifra `capi_token_cipher` da tabela
# `meta_capi_sites`. A MESMA chave tem que estar também nos secrets da Edge
# Function `capi-router`, que é quem decifra na hora de chamar a Meta:
#
#     supabase secrets set CAPI_MASTER_KEY='<a mesma chave>'
#
# No desenvolvimento local, o valor vai em `.env.server` (veja
# `.env.server.example`), não aqui. Sem ela, /api/meta-capi/sites responde 503
# e não grava nada — não existe fallback para token em texto puro.
CAPI_MASTER_KEY=

# Pautador Pro (backend FastAPI)
VITE_PAUTADOR_API_URL=http://localhost:8010
VITE_PAUTADOR_API_KEY=
