# Frontend Configuration (Safe to expose)
# These values are bundled into the frontend and visible to users

# Supabase Configuration (Public - Safe for frontend)
# IMPORTANT: Use anon key only, never service role key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Secure API Backend URL
VITE_API_URL=http://localhost:3001

# Production URL (configure this in Vercel)
VITE_SITE_URL=https://your-domain.vercel.app