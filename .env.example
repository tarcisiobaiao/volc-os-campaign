# Supabase (obrigatório para o frontend)
# IMPORTANTE: Use SEMPRE o endpoint da agência VOLC
VITE_SUPABASE_URL=https://database.agenciavolc.com.br
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Opcional: apenas para uso server-side (ex.: API routes, Vercel serverless)
SUPABASE_SERVICE_ROLE_KEY=

# Secret key base (opcional)
SECRET_KEY_BASE=
