# ============================================================================
# Pautador Pro backend — environment variables
# Copy to .env (local) or set in the Vercel project dashboard (2nd project).
# The backend boots with ZERO of these set (mock engine + dry mode).
# ============================================================================

# --- LLM engine -------------------------------------------------------------
# auto = first provider with a key, else mock | mock | gemini | openai
PAUTADOR_ENGINE=auto

# Google Gemini (primary discovery engine, mirrors the n8n prototype)
# IMPORTANTE: a GEMINI_API_KEY vive SOMENTE no backend (server-side).
# NUNCA use prefixo VITE_ nem coloque esta chave no frontend.
GEMINI_API_KEY=
# GOOGLE_API_KEY=                  # alias also accepted
PAUTADOR_GEMINI_MODEL=gemini-2.0-flash
# Cap de tokens de saída do Gemini. Vazio = omite (cada modelo usa seu limite,
# ex.: gemini-3.x flash = 65536). NÃO fixe 8192 em modelos "thinking" (trunca o JSON).
# PAUTADOR_GEMINI_MAX_OUTPUT_TOKENS=

# Perplexity Sonar Pro (the mandated external grounding for Phase 1 + Fases 2/3)
PERPLEXITY_API_KEY=
PAUTADOR_PERPLEXITY_MODEL=sonar-pro
PAUTADOR_GROUNDING_ENABLED=true

# --- Pautador KW Mining (Fase 2) / Funnel Builder (Fase 3) ------------------
# Per-operation Gemini models (the n8n workflows used gemini-3.1-pro-preview).
# NÃO mexe no modelo da descoberta (PAUTADOR_GEMINI_MODEL) — estes são só p/ mining/funnel.
PAUTADOR_KW_GEMINI_MODEL=models/gemini-3.1-pro-preview
PAUTADOR_FUNNEL_GEMINI_MODEL=models/gemini-3.1-pro-preview
# Entity Funil (Fase 3) — agente ARQUITETO do FUNNEL.json, com gemini-3.5-flash.
PAUTADOR_ENTITY_FUNNEL_MODEL=models/gemini-3.5-flash

# KW mining via n8n: URL do webhook (flow n8n/pautador_kw_mining_webhook.json).
# Vazio => "Minerar" usa o minerador interno (mock/gemini). Setado => dispara o n8n.
PAUTADOR_N8N_KW_WEBHOOK_URL=

# DataForSEO (Google Autocomplete + Related Keywords Labs). Basic auth.
# Migrado do header Authorization hardcoded no n8n. Vazio => mineração usa MOCK honesto.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Ads Keyword Planner (generateKeywordIdeas) — DOIS modos de auth.
# Migrado de mcc_id/customer_id/developer_token hardcoded no n8n. Vazio => MOCK.
#
# Modo: service_account | oauth_refresh_token | auto (default: detecta sozinho)
GOOGLE_ADS_AUTH_MODE=auto
# Comuns aos DOIS modos (obrigatórios):
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
# -- Modo oauth_refresh_token --
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# -- Modo service_account (use JSON inline OU o caminho do arquivo; NÃO os dois) --
# GOOGLE_ADS_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
GOOGLE_ADS_JSON_KEY_FILE_PATH=
# Opcional: e-mail a impersonar (domain-wide delegation)
GOOGLE_ADS_IMPERSONATED_EMAIL=
# Obs.: se a service account estiver configurada, NÃO precisa de refresh token.

# KW mining: auto (real quando configurado, senão mock) | mock | live
PAUTADOR_KW_ENGINE=auto
PAUTADOR_KW_MAX_LOOPS=5
PAUTADOR_KW_MIN_VOLUME_GOLD=10

# OpenAI (optional alternative engine)
OPENAI_API_KEY=
PAUTADOR_OPENAI_MODEL=gpt-4o-mini

# --- Supabase oficial VOLC O.S. (service-role; SERVER-SIDE ONLY) -------------
# Única autoridade operacional deste projeto. Referências *.supabase.co são
# legado, fixture de teste ou material arquivado — nunca destino de produção.
SUPABASE_URL=https://database.agenciavolc.com.br
SUPABASE_SERVICE_ROLE_KEY=

# --- ClickUp (server-side only) ----------------------------------------------
# Token pessoal. Nunca use prefixo VITE_ e nunca envie esta chave ao frontend.
CLICKUP_API_TOKEN=
# ID da lista que receberá as tasks criadas pelo backend.
CLICKUP_LIST_ID=
# Opcional. Vazio usa o status inicial padrão configurado na lista.
CLICKUP_TASK_STATUS=

# --- HTTP / behaviour -------------------------------------------------------
# Comma-separated origins. Dev (Vite roda na :8080). Use a origem do front em prod.
PAUTADOR_ALLOWED_ORIGINS=http://localhost:8080
PAUTADOR_PERSIST_DEFAULT=true
PAUTADOR_DEFAULT_COUNT=40
REQUEST_TIMEOUT_SECONDS=120

# --- Endpoint auth (IMPORTANT in production) --------------------------------
# The backend holds the RLS-bypassing service-role key. When PAUTADOR_API_KEY
# is set, mutating/compute endpoints (discovery/mine/funnel/status/opportunities)
# require header `X-API-Key: <this>`. Leave empty for local/mock (open).
# In the frontend set the SAME value as VITE_PAUTADOR_API_KEY.
PAUTADOR_API_KEY=

# Cofre de credenciais de terceiros. Gere a sua com:
#   cd backend && .venv/bin/python -c "import sys; sys.path.insert(0,'.'); from app.seguranca import gerar_chave; print(gerar_chave())"
VOLC_SEGREDO_KEY=
