{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volc.local/schemas/freedom-lab-experimento.schema.json",
  "title": "VOLC Freedom Lab — experimento de engine ou modelo",
  "description": "Formato único de experimento. Regras semânticas que JSON Schema não expressa (observado × estimado, decisão coerente com o resultado, limpeza feita) ficam em volc_lab.experimentos.validar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "hypothesis",
    "baseline",
    "input_snapshot",
    "method",
    "dependencies",
    "metrics",
    "result",
    "limitations",
    "decision",
    "rollback_or_cleanup",
    "artifacts"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{5,}$"
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "falsified_if",
        "primary_metric",
        "direction",
        "min_effect"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 10
        },
        "falsified_if": {
          "description": "Condição observável e mensurável que refuta a hipótese. Sem ela a hipótese não é falsificável.",
          "type": "string",
          "minLength": 10
        },
        "primary_metric": {
          "type": "string",
          "minLength": 1,
          "description": "Chave em result.observed que decide a hipótese."
        },
        "direction": {
          "enum": [
            "increase",
            "decrease"
          ]
        },
        "min_effect": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Efeito mínimo absoluto, > 0 (empate não adota)."
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "description",
        "values"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 3
        },
        "values": {
          "type": "object"
        }
      }
    },
    "input_snapshot": {
      "type": "object",
      "required": [
        "id",
        "source",
        "sha256",
        "contains_pii"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "source": {
          "type": "string",
          "minLength": 3
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": "string"
        },
        "contains_pii": {
          "const": false
        }
      }
    },
    "method": {
      "type": "object",
      "required": [
        "description",
        "replay_without_api",
        "external_writes",
        "external_calls",
        "environment"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 3
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "seeds_not_applicable_reason": {
          "type": "string"
        },
        "replay_without_api": {
          "type": "boolean"
        },
        "replay_not_possible_reason": {
          "type": "string"
        },
        "external_writes": {
          "const": 0
        },
        "external_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "count"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "readonly",
                "validate_only"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "environment": {
          "type": "object",
          "required": [
            "base_ref",
            "lock_sha256"
          ],
          "properties": {
            "base_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "lock_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package",
          "version"
        ],
        "properties": {
          "package": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "time",
        "cost",
        "quality"
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/medida"
        },
        "cost": {
          "$ref": "#/$defs/medida"
        },
        "quality": {
          "$ref": "#/$defs/medida"
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "observed",
        "estimated"
      ],
      "properties": {
        "observed": {
          "type": "object",
          "description": "Somente o que foi medido nesta execução."
        },
        "estimated": {
          "type": "object",
          "description": "Projeções, extrapolações e simulações; nunca misturar com observed."
        },
        "hypothesis_outcome": {
          "enum": [
            "supported",
            "refuted",
            "inconclusive"
          ]
        },
        "reproducible": {
          "enum": [
            "identical",
            "within_tolerance",
            "not_reproduced",
            "not_repeated"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 1
    },
    "decision": {
      "enum": [
        "adopt",
        "reject",
        "repeat"
      ]
    },
    "rollback_or_cleanup": {
      "type": "object",
      "required": [
        "steps",
        "done"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "done": {
          "type": "boolean"
        },
        "verified_by": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*(^|/)\\.[eE][nN][vV])[^\\\\]+$",
            "description": "Relativo ao diretório do experimento; sem /, .. ou .env."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    }
  },
  "$defs": {
    "medida": {
      "type": "object",
      "required": [
        "unit",
        "kind"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "observed",
            "estimated",
            "not_measured"
          ]
        },
        "not_measured_reason": {
          "type": "string"
        }
      }
    }
  }
}
