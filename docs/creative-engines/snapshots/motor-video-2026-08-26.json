  "contract": {
    "global_rules": [
      "REGRA:sem-zumbido — proibido riser/sfx de seno puro estático; usar swell de ruído filtrado",
      "REGRA:anti-colisao — beat com sting+card: sting entra 0.1s, card espera 1.55s (card_slot)",
      "REGRA:copy-punch — fala de avatar: ≤9 palavras/3s, ≤12/4s; prompt sempre com 'EXACTLY N SECONDS' + 'finishes speaking 0.3s before the end'",
      "REGRA:sem-histeria — estilos TTS calibrados naturais; proibido 'MUITO empolgada/indignação' no style",
      "REGRA:legenda-integra — CaptionsPro: overflow visible, lineHeight ≥1.16 (nunca decapitar glifos)",
      "REGRA:disclosure — avatar/cena IA simulando UGC ⇒ marcar conteúdo sintético na plataforma + ledger synthid",
      "REGRA:2-fontes — fato sensível: 2+ fontes; sem prova primária ⇒ 'registros apontam'",
      "REGRA:nunca-clipe-de-terceiro — zero vídeo de terceiros (Content ID); stills/imagens apenas",
      "REGRA:pessoa-real-so-wikimedia — rosto real só via Commons CC/PD creditado ou still de divulgação editorial",
      "REGRA:zero-gore — tragédia narrada, nunca mostrada; selos RECONSTITUIÇÃO em cena IA",
      "REGRA:ledger — todo vídeo escreve clips_registry.json com licença por asset",
      "REGRA:qa-gate — build aborta se QA reprovar (set -o pipefail)",
      "REGRA:emoji-props — testar emoji em card (🔫 vira pistola d'água verde; usar ⚡/🔎)",
      "REGRA:metadata-gate — MP4 aprovado no QA ainda não é publicável: freeze→gen→check de publicar.py é obrigatório antes do upload",
      "REGRA:ledger-incompleto — toda cena do props congelado deve constar no ledger; ausência = FAIL na publicação"
    ],
    "locales": {
      "dir": "contrato/locales/<skin>.json",
      "langs": [
        "pt",
        "en",
        "es"
      ],
      "loader": "motor/locales.py (get/validate/verify-source/scaffold→draft→promote; fail-fast em placeholder sem fmt e compliance vazio)",
      "regra": "idioma só entra com VOZ:* resolvível no grafo; scaffold nunca derruba skin em produção (draft+promote)",
      "skins_cobertas": [
        "corta",
        "gossip",
        "holerite"
      ]
    },
    "map_sha256": "878cffb957ca9e574d43987a7c4b78dd19204cd3860388a3d6f9cc072f09913f",
    "publication": {
      "canais": "motor/canais.json (i18n por idioma: h_creditos/ia_line/disclosure/...)",
      "checks_gate": [
        "ledger_incompleto (scenes×ledger)",
        "disclosure/altered_content",
        "creditos CC",
        "qa_visual (FAIL bloqueia; SKIPPED exige --allow-skip-visual com motivo)"
      ],
      "cli": "motor/publicar.py",
      "fluxo": "QA gate → qa_visual → freeze → gen → check → pack → log",
      "regras": [
        "REGRA:metadata-gate",
        "REGRA:ledger-por-video",
        "REGRA:disclosure"
      ],
      "snapshot": "out/meta/<slug>/ (props+ledger+timings+qa+qa_visual congelados; freeze valida identidade e sha)"
    },
    "reference_costs": {
      "SRC:geminiimg": "US$0.039/img",
      "SRC:gptimg": "low ~US$0.02-0.04/img",
      "SRC:grok": "kie.ai por clipe 6s",
      "SRC:omni": "US$0.10/s (~0.40/hook 4s)",
      "SRC:pexels": "grátis",
      "SRC:wikimedia": "grátis+crédito"
    },
    "required_fields": [
