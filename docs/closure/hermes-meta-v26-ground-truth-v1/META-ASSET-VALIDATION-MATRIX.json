{
  "asset_feed_spec_limits": {
    "limits": {
      "bodies": 5,
      "call_to_action_types": 5,
      "images": 10,
      "titles": 5,
      "total_assets": 30,
      "videos": 10
    },
    "rule": "Validate before any adcreative submission; MVP single-creative path should avoid dynamic asset-feed unless explicitly enabled.",
    "source": "https://developers.facebook.com/documentation/ads-commerce/marketing-api/ad-creative/asset-feed-spec/options"
  },
  "rules": [
    {
      "check": "sha256 over bytes required",
      "failure": "META_ASSET_HASH_REQUIRED",
      "id": "ASSET_SHA256",
      "phase": "MVP_NOW",
      "type": "image_video"
    },
    {
      "check": "sniff MIME and compare extension/declared MIME",
      "failure": "META_ASSET_MIME_MISMATCH",
      "id": "ASSET_MIME_SNIFF",
      "phase": "MVP_NOW",
      "type": "image_video"
    },
    {
      "check": "placement-specific size/aspect constraints must cite source/date; volatile specs not frozen without source",
      "failure": "META_ASSET_PLACEMENT_INCOMPATIBLE",
      "id": "ASSET_PLACEMENT_COMPAT",
      "phase": "MVP_NEXT",
      "type": "image_video"
    }
  ]
}
