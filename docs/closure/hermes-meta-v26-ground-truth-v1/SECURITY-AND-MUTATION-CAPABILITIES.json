{
  "schema_version": 2,
  "principle": "Absence of an exact capability is a hard block. A parent capability authorizes only covered_matrix_capabilities. META_CREATE_PAUSED never authorizes META_ENABLE.",
  "common_controls": {
    "actor": "backend service acting for an authenticated human operator",
    "authorization": ["authenticated actor", "project membership", "active project/account binding", "explicit capability", "object belongs to bound account"],
    "secrets": "Only a privileged server-side broker resolves cofre_credencial_referencia; browser, logs, errors and receipts never expose locator or token.",
    "mutation": ["fresh before-state", "redacted proposed-state", "human approval", "idempotency", "append-only receipt", "external read-back"],
    "errors": ["NOT_CONFIGURED", "UNAUTHORIZED", "STALE", "CONFLICT", "LIMIT_EXCEEDED", "EXTERNAL_ERROR", "READBACK_MISMATCH"]
  },
  "capabilities": [
    {
      "capability": "META_READ_INVENTORY",
      "scope": "project/account/read-only",
      "human_approval_required": false,
      "covered_matrix_capabilities": ["META_BUSINESS_REFERENCE", "META_SYSTEM_USER_REFERENCE", "META_APP_REFERENCE", "META_AD_ACCOUNT_REFERENCE", "META_PAGE_REFERENCE", "META_INSTAGRAM_ACCOUNT_REFERENCE", "META_PIXEL_DATASET_REFERENCE", "META_CAMPAIGN_READ", "META_ADSET_READ", "META_AD_READ", "META_CREATIVE_READ", "META_INSIGHTS_SPEND", "META_INSIGHTS_IMPRESSIONS", "META_INSIGHTS_CLICKS", "META_INSIGHTS_REACH", "META_INSIGHTS_FREQUENCY", "META_INSIGHTS_CPM", "META_INSIGHTS_CPC", "META_INSIGHTS_CTR", "META_INSIGHTS_ACTIONS", "META_INSIGHTS_ACTION_VALUES", "META_INSIGHTS_LANDING_PAGE_VIEWS", "META_INSIGHTS_CURRENCY", "META_INSIGHTS_TIMEZONE", "META_INSIGHTS_BREAKDOWNS", "META_INSIGHTS_ASYNC_INSIGHTS", "META_INSIGHTS_PAGINATION", "META_INSIGHTS_FRESHNESS"],
      "receipt": "sync-run/read receipt with account, levels, dates, counts and freshness; redacted",
      "read_back": "not applicable to external mutation"
    },
    {
      "capability": "META_MANAGE_BINDING",
      "scope": "project/Cofre metadata",
      "human_approval_required": true,
      "covered_matrix_capabilities": ["META_PROJECT_BINDING"],
      "idempotency_key": "project_id:ad_account_ativo_id:open_interval",
      "before_and_proposed": true,
      "receipt": "binding created/closed with opaque internal IDs",
      "read_back": "re-read active binding and readiness; never resolve secret into response",
      "compensation": "close the newly opened binding interval"
    },
    {
      "capability": "META_VALIDATE_BLUEPRINT",
      "scope": "local blueprint/lote",
      "human_approval_required": false,
      "covered_matrix_capabilities": [],
      "note": "Internal deterministic capability; it performs no Graph request and does not imply remote validation.",
      "receipt": "validation record linked to lote/item",
      "read_back": "re-read persisted validation"
    },
    {
      "capability": "META_VALIDATE_BLUEPRINT_REMOTE",
      "scope": "account/blueprint",
      "human_approval_required": true,
      "covered_matrix_capabilities": [],
      "note": "Future and blocked until a pinned Graph API validation operation is confirmed.",
      "idempotency_key": "account_id:blueprint_id:version:remote_validate",
      "receipt": "request/result redacted",
      "read_back": "operation-specific if supported"
    },
    {
      "capability": "META_UPLOAD_ASSET",
      "scope": "criativo_master/account",
      "human_approval_required": true,
      "covered_matrix_capabilities": ["META_IMAGE_UPLOAD", "META_VIDEO_UPLOAD"],
      "idempotency_key": "meta_ad_account_id:criativo_master_id:content_hash",
      "before_and_proposed": true,
      "receipt": "upload request/result plus trafego_meta_asset_upload association",
      "read_back": "confirm returned image hash/video status for the same account",
      "compensation": "mark association failed/orphaned; no blind external delete"
    },
    {
      "capability": "META_CREATE_PAUSED",
      "scope": "account/campaign/adset/ad/creative",
      "human_approval_required": true,
      "covered_matrix_capabilities": ["META_CAMPAIGN_CREATE_PAUSED", "META_CAMPAIGN_ADVANTAGE_BUDGET", "META_ADSET_CREATE_TRAFFIC_LPV", "META_AD_CREATE_PAUSED", "META_CREATIVE_CREATE_LINK_IMAGE", "META_DYNAMIC_CREATIVE_ASSET_FEED"],
      "idempotency_key": "account_id:trafego_lote_item.idempotency_key",
      "before_and_proposed": true,
      "monetary_limit": "required for proposed budgets; creation remains PAUSED",
      "receipt": "one append-only receipt per ordered item",
      "read_back": "GET every created object and prove PAUSED/effective status",
      "compensation": "pause/archive only when separately allowed; never enable"
    },
    {
      "capability": "META_CHANGE_BUDGET",
      "scope": "account/campaign-or-adset",
      "human_approval_required": true,
      "covered_matrix_capabilities": ["META_CHANGE_BUDGET"],
      "idempotency_key": "account_id:object_id:target_budget:approval_id",
      "before_and_proposed": true,
      "monetary_limit": "mandatory absolute and percentage delta caps",
      "receipt": "before/proposed/result/read-back",
      "read_back": "confirm budget and currency",
      "compensation": "restore before value under a new approved operation"
    },
    {
      "capability": "META_CHANGE_BID",
      "scope": "account/adset",
      "human_approval_required": true,
      "covered_matrix_capabilities": ["META_CHANGE_BID"],
      "idempotency_key": "account_id:adset_id:strategy:amount:approval_id",
      "before_and_proposed": true,
      "monetary_limit": "mandatory when bid amount is present",
      "receipt": "before/proposed/result/read-back",
      "read_back": "confirm bid strategy and amount",
      "compensation": "restore before value under a new approved operation"
    },
    {
      "capability": "META_PAUSE",
      "scope": "account/object",
      "human_approval_required": true,
      "covered_matrix_capabilities": ["META_PAUSE"],
      "idempotency_key": "account_id:object_id:PAUSED:approval_id",
      "before_and_proposed": true,
      "receipt": "before/proposed/result/read-back",
      "read_back": "confirm configured and effective status",
      "compensation": "none implicit; enabling requires META_ENABLE"
    },
    {
      "capability": "META_ENABLE",
      "scope": "account/object",
      "human_approval_required": true,
      "covered_matrix_capabilities": ["META_ENABLE"],
      "idempotency_key": "account_id:object_id:ACTIVE:approval_id",
      "before_and_proposed": true,
      "monetary_limit": "must prove approved budget/spend caps before activation",
      "receipt": "before/proposed/result/read-back",
      "read_back": "confirm configured/effective status and delivery blockers",
      "compensation": "pause under META_PAUSE"
    },
    {
      "capability": "META_RENAME",
      "scope": "account/object",
      "human_approval_required": true,
      "covered_matrix_capabilities": ["META_RENAME"],
      "idempotency_key": "account_id:object_id:new_name_hash:approval_id",
      "before_and_proposed": true,
      "receipt": "old/new name and read-back",
      "read_back": "confirm exact name",
      "compensation": "restore old name under a new approved operation"
    },
    {
      "capability": "META_DUPLICATE",
      "scope": "account/object",
      "human_approval_required": true,
      "covered_matrix_capabilities": ["META_DUPLICATE"],
      "idempotency_key": "account_id:source_object_id:trafego_lote_item.idempotency_key",
      "before_and_proposed": true,
      "receipt": "source, new object IDs and read-back",
      "read_back": "confirm duplicated object remains PAUSED",
      "compensation": "pause/archive created duplicate if separately allowed"
    },
    {
      "capability": "META_ARCHIVE",
      "scope": "account/object",
      "human_approval_required": true,
      "covered_matrix_capabilities": ["META_ARCHIVE"],
      "idempotency_key": "account_id:object_id:ARCHIVED:approval_id",
      "before_and_proposed": true,
      "receipt": "before/proposed/result/read-back",
      "read_back": "confirm archived state",
      "compensation": "none assumed; reversibility must be verified before authorization"
    }
  ]
}
