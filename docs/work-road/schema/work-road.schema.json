{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volc.local/schemas/work-road.schema.json",
  "title": "VOLC Work Road Initiative",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "objective",
    "cluster",
    "work_state",
    "product_state",
    "owner",
    "scope",
    "dependencies",
    "acceptance"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 3 },
    "objective": { "type": "string", "minLength": 10 },
    "cluster": { "type": "string", "minLength": 2 },
    "work_state": {
      "enum": ["ready", "claimed", "in_progress", "review", "blocked", "done"]
    },
    "product_state": {
      "enum": ["planned", "partial", "implemented", "legacy", "parked"]
    },
    "risk": { "enum": ["normal", "external", "accepted"] },
    "owner": { "type": "string", "minLength": 1 },
    "branch": { "type": ["string", "null"] },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "label": { "type": "string", "minLength": 5 },
          "initially_done": { "type": "boolean" }
        }
      }
    }
  }
}

