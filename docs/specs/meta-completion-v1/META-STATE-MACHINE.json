{
  "activation": {
    "act_id": "ACT-ACTIVATE-FUTURE",
    "gate_ids": [
      "G11"
    ],
    "p0_endpoint": false,
    "release": "future_separate"
  },
  "artifact_id": "META-STATE-MACHINE",
  "dependency_rules": [
    "AdSet needs verified Campaign ID.",
    "Creative independent; can be validated before any creation.",
    "Ad needs verified AdSet and Creative.",
    "Validate child with real parents immediately before preparing its create attempt; persist validation result before dispatch.",
    "Resume never repeats CREATED/AMBIGUOUS step; verified known identity advances only under current authorized execution."
  ],
  "existing_state_mapping": {
    "AMBIGUOUS": "uncertain external outcome",
    "APPROVED": "SQL approval with computed expiry; no consumed execution state",
    "CREATED": "ID durable but readback verified not guaranteed",
    "FAILED": "provider refusal or temporal absence closure; latter unsafe",
    "IN_FLIGHT": "prepared/dispatch uncertain conflated",
    "readback_error_code": "separate nullable field, not complete persisted equivalence model"
  },
  "forbidden_transitions": [
    "AMBIGUOUS -> new POST without adjudicated no-dispatch proof and new authority",
    "ROOTS_VALIDATED -> fully_remote_validated",
    "APPROVED -> ACTIVE",
    "RECONCILE -> CREATE",
    "READBACK_DIVERGENT -> success without new read evidence"
  ],
  "global_transitions": [
    {
      "condition": "draft/hash/input/manifest change",
      "effect": "invalidate approval and validation; never modify running execution",
      "to": "S-DRAFT"
    },
    {
      "condition": "unconsumed approval expiry",
      "effect": "no dispatch and no token; recovery separate",
      "to": "S-EXPIRED"
    },
    {
      "condition": "operator revocation",
      "effect": "stop future dispatch; existing nodes retainedPAUSED; in-flight stays potentially ambiguous",
      "to": "S-REVOKED"
    },
    {
      "condition": "explicit provider refusal",
      "effect": "preserve partial parents and exact error, do not call it timeout",
      "to": "S-REFUSED"
    }
  ],
  "model": "proposed; does not falsely map every state to existing SQL",
  "no_delivery_rule": "Campaign, AdSet and Ad configured statusPAUSED individually; Creative library state not delivery status.",
  "schema_version": "1.0.0",
  "states": [
    "S-DRAFT",
    "S-COMPILED",
    "S-LOCAL-VALID",
    "S-ROOTS-VALIDATED",
    "S-VALIDATION-DURABLE",
    "S-APPROVED",
