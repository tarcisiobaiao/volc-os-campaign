[Unit]
Description=VOLC Google Ads intelligence collection (%i)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/volc-google-intelligence/current
EnvironmentFile=/root/supabase/docker/.env
ExecStart=/opt/volc-google-intelligence/run.sh %i
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
