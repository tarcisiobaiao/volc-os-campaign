# =============================================================================
# deploy/postiz/.env.example — SOMENTE NOMES. Nenhum valor real, nunca.
# =============================================================================
#
# COMO ESTE ARQUIVO E DIFERENTE DE UM .env
#
# Este arquivo e versionado; o `.env` ao lado dele NAO e (a regra `.env` do
# .gitignore da raiz cobre qualquer diretorio, e `!.env.example` abre a excecao
# so para este). Copie e preencha na maquina que hospeda:
#
#     cp deploy/postiz/.env.example deploy/postiz/.env
#     chmod 600 deploy/postiz/.env
#     ${EDITOR:-vi} deploy/postiz/.env
#
# TODAS as entradas abaixo estao VAZIAS de proposito. Uma entrada vazia e
# tratada pelo compose como "nao definida": onde ha default (`${VAR:-...}`), o
# default entra; onde a variavel e obrigatoria (`${VAR:?...}`), o `up` PARA com
# uma mensagem dizendo qual nome falta. Isso e melhor do que subir com um valor
# de exemplo que alguem esqueceu de trocar.
#
# ⚠️ A convencao desta casa (backend/.env.example, .env.example da raiz) e
# exatamente esta: documentar o NOME e o que ele significa, nunca o valor.
#
# =============================================================================
# 1. AS SEIS OBRIGATORIAS DO POSTIZ — e por que a maioria nao esta aqui
# =============================================================================
#
# A referencia oficial de configuracao (docs.postiz.com/self-host/configuration/
# reference, 02/09/2026) lista como obrigatorias, DENTRO do container:
#
#   DATABASE_URL             — montada pelo docker-compose.yml a partir de
#                              POSTIZ_POSTGRES_USER + _PASSWORD + _DB. NAO
#                              defina aqui: a senha tem uma fonte so, e escrever
#                              a URL inteira num lugar e a senha noutro garante
#                              que um dia os dois divirjam.
#   REDIS_URL                — vem de POSTIZ_REDIS_URL (abaixo).
#   JWT_SECRET               — vem de POSTIZ_JWT_SECRET (abaixo).
#   FRONTEND_URL             — vem de POSTIZ_FRONTEND_URL (abaixo).
#   NEXT_PUBLIC_BACKEND_URL  — vem de POSTIZ_PUBLIC_BACKEND_URL (abaixo).
#   BACKEND_INTERNAL_URL     — vem de POSTIZ_BACKEND_INTERNAL_URL (abaixo).
#
# ⚠️ POR QUE OS NOMES DO HOST TEM PREFIXO `POSTIZ_` E OS DO CONTAINER NAO:
# `DATABASE_URL`, `REDIS_URL` e `JWT_SECRET` sao nomes genericos demais. Se o
# compose lesse esses nomes direto do ambiente do host, um shell que ja tivesse
# `DATABASE_URL` do backend VOLC exportada injetaria a URL do Supabase dentro
# do container do Postiz — que e precisamente a mistura que o ADR de 28/08/2026
# proibe. O prefixo torna a colisao impossivel por construcao.

# =============================================================================
# 2. BANCO DO POSTIZ (Postgres proprio dele — NAO e o Supabase do VOLC)
# =============================================================================

# Usuario do Postgres do Postiz. Ex.: um nome dedicado, nunca `postgres`.
POSTIZ_POSTGRES_USER=

# Senha desse usuario. Gere com `openssl rand -hex 24`.
# ⚠️ USE SO [A-Za-z0-9._-]. Esta senha entra CRUA na DATABASE_URL montada pelo
# compose; um `@`, `:`, `/`, `#`, `?` ou `%` quebra o parser de URL do Prisma e
# o erro resultante nao diz que a culpa e da senha.
POSTIZ_POSTGRES_PASSWORD=

# Nome do banco. Ex.: `postiz`.
POSTIZ_POSTGRES_DB=

# =============================================================================
# 3. REDIS
# =============================================================================

# URL do Redis vista de dentro da rede do compose.
# Default se vazia: redis://postiz-redis:6379
# Sem senha porque este Redis nao tem porta publicada e vive numa rede
# `internal: true` — nao ha de onde alcancar. Se um dia ele sair dessa rede,
# esta linha deixa de ser suficiente.
POSTIZ_REDIS_URL=

# =============================================================================
# 4. SEGREDO DE SESSAO
# =============================================================================

# JWT_SECRET do Postiz: assina as sessoes da interface dele.
# Gere com `openssl rand -base64 48`.
# ⚠️ Trocar este valor invalida TODAS as sessoes abertas. Isso NAO afeta o
# POSTIZ_API_TOKEN que o VOLC usa (sao coisas diferentes: um e sessao de
# navegador, outro e chave de API emitida pela interface).
POSTIZ_JWT_SECRET=

# =============================================================================
# 5. URLs PUBLICAS
# =============================================================================

# FRONTEND_URL — a URL pela qual uma PESSOA abre o Postiz no navegador.
# Ex.: https://postiz.interno.exemplo (com TLS terminado no reverse proxy).
POSTIZ_FRONTEND_URL=

# NEXT_PUBLIC_BACKEND_URL — a URL da API vista pelo NAVEGADOR da pessoa.
# ⚠️ `NEXT_PUBLIC_*` no Next.js e embutido no bundle JavaScript, ou seja, e
# publico por definicao. Nunca ponha segredo em variavel com esse prefixo.
POSTIZ_PUBLIC_BACKEND_URL=

# BACKEND_INTERNAL_URL — como o processo do front alcanca o back DENTRO do
# mesmo container. Default se vazia: http://localhost:3000
# Nao mexa sem motivo: nao e a URL que o VOLC usa (essa e POSTIZ_BASE_URL,
# secao 9).
POSTIZ_BACKEND_INTERNAL_URL=

# =============================================================================
# 6. CONTROLES DE SEGURANCA — as tres que decidem a postura da instancia
# =============================================================================

# DISABLE_REGISTRATION — default se vazia: true.
# `true` fecha o cadastro publico. Um Postiz self-hosted com registro aberto e
# um formulario na internet que cria contas com poder de publicar nas paginas
# reais dos clientes. Mantenha `true`; para criar o primeiro usuario, ligue
# temporariamente, cadastre, desligue e suba de novo (o README descreve).
POSTIZ_DISABLE_REGISTRATION=

# API_LIMIT — teto de requisicoes por hora do endpoint de criacao de post.
# Default se vazia: 30.
# ⚠️ DIVERGENCIA OFICIAL REGISTRADA (02/09/2026): docs.postiz.com/public-api/
# posts/create diz "30 requests per hour"; docs.postiz.com/public-api/
# introduction diz "90 requests per hour (100 for the cloud)"; a referencia de
# configuracao traz 90 como default. As duas paginas sao oficiais e discordam.
# O default deste pacote e o MENOR numero — errar para menos atrasa um despacho;
# errar para mais produz 429 no meio do despacho, e ai o ledger da v14_01 tem de
# reconciliar um desfecho incerto. Nao "resolvemos" a divergencia por palpite.
POSTIZ_API_LIMIT=

# RESTRICT_UPLOAD_DOMAINS — lista de dominios de onde `POST /upload-from-url`
# pode buscar arquivo. Esta variavel tem de estar DECLARADA (o compose usa
# `${VAR?...}`, sem dois-pontos), mas PODE ficar vazia.
# A declaracao obrigatoria e o ponto: obriga alguem a decidir. Vazia e uma
# decisao legitima enquanto esta v1 nao envia midia — `upload_de_midia` esta
# registrada como capacidade NAO exercitada em portas.py.
POSTIZ_RESTRICT_UPLOAD_DOMAINS=

# =============================================================================
# 7. PROIBIDAS — nao existem no docker-compose.yml, e o validador garante isso
# =============================================================================
#
# Estas duas variaveis sao reconhecidas pelo Postiz e NAO PODEM ser ligadas
# neste pacote. Elas estao aqui NOMEADAS, comentadas, para que ninguem precise
# descobrir sozinho por que faltam — e para que a proibicao seja explicita em
# vez de silenciosa.
#
#   DISABLE_SSRF_PROTECTION
#     Desliga a protecao contra Server-Side Request Forgery do proprio Postiz.
#     Com ela desligada, qualquer URL aceita pelo Postiz (upload por URL,
#     webhook, preview de link) vira um pedido feito PELO container — que esta
#     na rede `borda` e alcanca a internet, e que na mesma pilha alcanca o
#     Postgres, o Redis e o Temporal pela rede interna. E o caminho classico
#     para ler metadata de nuvem em 169.254.169.254 e sair com credencial.
#     ⚠️ Existe simetria aqui que vale notar: o adaptador do VOLC
#     (backend/app/publicacao_organica/adaptadores/postiz.py) faz a MESMA
#     defesa na direcao oposta — `validar_base_url` recusa host privado sem
#     POSTIZ_PERMITIR_REDE_INTERNA declarado. Ligar esta variavel derrubaria
#     metade dessa simetria.
#
#   NOT_SECURED
#     Afrouxa a exigencia de contexto seguro (cookies/HTTPS). Serve para
#     experimentacao em `http://localhost` e nada mais. Em qualquer instancia
#     que alguem consiga alcancar pela rede, ela transforma a sessao
#     administrativa em algo interceptavel. A alternativa correta e TLS no
#     reverse proxy — que e o desenho descrito no README.
#
# Se um dia a operacao PRECISAR de uma das duas, o caminho nao e editar o
# compose: e escrever a decisao (ADR), mudar o pacote e mudar o validador
# junto, de forma que a excecao fique registrada e visivel.

# =============================================================================
# 8. ARMAZENAMENTO, AGENDA INTERNA E FRONTEIRA DE REDE
# =============================================================================

# STORAGE_PROVIDER — default se vazia: local (arquivos no volume postiz-uploads).
# A alternativa oficial e Cloudflare R2 (CLOUDFLARE_*), nao usada aqui: manter
# os arquivos no volume mantem o backup inteiro num procedimento so.
POSTIZ_STORAGE_PROVIDER=

# UPLOAD_DIRECTORY — default se vazia: /uploads (caminho DENTRO do container,
# onde o volume `postiz-uploads` esta montado). Mudar sem mudar o volume no
# compose faz os arquivos irem para o rootfs efemero e sumirem no proximo
# `docker compose up`.
POSTIZ_UPLOAD_DIRECTORY=

# NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY — default se vazia: /uploads.
POSTIZ_UPLOAD_STATIC_DIRECTORY=

# TEMPORAL_ADDRESS — default se vazia: temporal:7233 (DNS interno do compose).
# ⚠️ Este Temporal e a agenda INTERNA do Postiz, nao a autoridade de agenda do
# VOLC. Quem decide QUANDO um post sai e `horario_alvo` no ledger da v14_01.
POSTIZ_TEMPORAL_ADDRESS=

# TEMPORAL_NAMESPACE — default se vazia: default.
POSTIZ_TEMPORAL_NAMESPACE=

# POSTIZ_BIND_ADDR — endereco do HOST onde a porta do Postiz e publicada.
# Default se vazia: 127.0.0.1 (so a propria maquina).
# ⚠️ O compose oficial publica `4007:5000`, que em Docker significa 0.0.0.0 —
# a instancia inteira exposta em toda interface, sem TLS, com o login
# administrativo junto. Trocar este valor por 0.0.0.0 desfaz essa decisao. Para
# expor de verdade, ponha um reverse proxy com TLS na frente e deixe o bind em
# loopback.
POSTIZ_BIND_ADDR=

# POSTIZ_PORT — porta no host. Default se vazia: 4007 (a mesma do oficial).
POSTIZ_PORT=

# =============================================================================
# 9. O QUE O *VOLC* LE — e que NAO pertence a este arquivo
# =============================================================================
#
# O backend do VOLC nao le nada deste .env. Ele le tres nomes do PROPRIO
# ambiente dele (backend/.env, secao do control plane), definidos em
# backend/app/config.py:
#
#   POSTIZ_BASE_URL               raiz da instancia; a API vive em /public/v1,
#                                 e quem acrescenta esse sufixo e o adaptador.
#                                 Ex.: http://postiz:5000 (rede interna) ou
#                                 https://postiz.interno.exemplo.
#   POSTIZ_API_TOKEN              a chave emitida DENTRO da interface do Postiz
#                                 (Settings > API). Vai crua no header
#                                 `Authorization`, sem prefixo `Bearer`.
#   POSTIZ_PERMITIR_REDE_INTERNA  o SIM explicito para base_url em http ou para
#                                 host privado/loopback. Sem ele o adaptador
#                                 recusa a chamada.
#
# ⚠️ Os tres tem nome parecido com os daqui e proposito oposto: os deste arquivo
# CONFIGURAM o Postiz; aqueles ENSINAM O VOLC A FALAR com ele. Nunca copie um
# valor de uma secao para a outra.

# =============================================================================
# 10. TEMPORAL (infraestrutura interna do Postiz)
# =============================================================================

# Usuario do Postgres DO TEMPORAL — terceiro banco distinto da pilha
# (Supabase do VOLC, Postgres do Postiz, este). Nenhum conhece o outro.
TEMPORAL_POSTGRES_USER=

# Senha desse usuario. `openssl rand -hex 24`.
TEMPORAL_POSTGRES_PASSWORD=

# Heap da JVM do Elasticsearch. Default se vazia: -Xms512m -Xmx512m.
# ⚠️ Mantenha Xms igual a Xmx: heap elastica no ES causa pausa de GC longa, e
# uma pausa longa reprova o healthcheck e derruba o Temporal por dependencia.
TEMPORAL_ES_JAVA_OPTS=

# Origens CORS aceitas pela UI do Temporal (so sobe com `--profile depuracao`).
# Default se vazia: http://localhost:8080
TEMPORAL_UI_CORS_ORIGINS=

# Porta no host para a UI do Temporal. Default se vazia: 8080.
# O bind e SEMPRE 127.0.0.1, sem variavel: nao ha motivo legitimo para expor um
# painel administrativo de workflow para fora da maquina. Acesso remoto = tunel
# SSH.
TEMPORAL_UI_PORT=
