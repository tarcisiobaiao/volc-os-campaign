# /opt/volc-sombra-carteira/sombra.env — configuração da agenda da sombra (W13).
# Sem segredo aqui: a service_role vem de /root/supabase/docker/.env (SERVICE_ROLE_KEY).

# Trava: só "sim" liga. Qualquer outro valor sai 65 sem ler nada.
VOLC_SOMBRA_HABILITADA=nao

# Contas Google Ads, 10 dígitos sem hífen, separadas por espaço.
# A conta ativa sob o MCC é a Portal Mundo Mais (creditoup.com.br).
VOLC_SOMBRA_CONTAS=5478096539

# Para onde vão os experimentos; o backend lê pela VOLC_EXPERIMENTOS_SHADOW_DIR.
VOLC_SOMBRA_DESTINO=/var/lib/volc-sombra-carteira/experimentos

# Parâmetros do laboratório (vazio = padrão do código, volc_lab/sombra_carteira/dominio.py).
VOLC_SOMBRA_JANELA_DIAS=
VOLC_SOMBRA_DIAS_IMATUROS=
VOLC_SOMBRA_MIN_CLIQUES_MADUROS=
VOLC_SOMBRA_MAX_CUSTO_SEM_RECEITA=
# Dias que uma cotação anterior ainda vale (p_max_defasagem_dias do cambio_resolver; padrão 7).
VOLC_SOMBRA_MAX_DEFASAGEM_CAMBIO_DIAS=
