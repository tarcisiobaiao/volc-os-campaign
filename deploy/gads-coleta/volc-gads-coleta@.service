[Unit]
Description=VOLC coleta Google Ads → ledger (%i)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/volc-gads-coleta/current
EnvironmentFile=/root/supabase/docker/.env
EnvironmentFile=/opt/volc-gads-coleta/conta.env
ExecStart=/opt/volc-gads-coleta/run.sh %i
SuccessExitStatus=75
TimeoutStartSec=45min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock /var/lib/volc-gads-coleta
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
